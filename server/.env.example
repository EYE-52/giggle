# Runtime
NODE_ENV=development
# Local synthetic @dev.giggle.local accounts can enter the app directly.
# Only takes effect when NODE_ENV=development. Keep off in shared environments.
DEV_AUTH_ENABLED=false
PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4000
ADMIN_EMAIL=safety@example.com

# Data stores
MONGODB_URI=mongodb://127.0.0.1:27017/giggle
MONGODB_DB_NAME=giggle
REDIS_URL=redis://127.0.0.1:6379
# Only set this for self-signed Redis TLS certificates in a controlled deployment.
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Secrets: generate high-entropy production values of at least 32 characters; never commit them.
JWT_SECRET=
AUTH_EXCHANGE_SECRET=

# Verified-adult age assurance. These are server-only values.
YOTI_AGE_API_KEY=
YOTI_AGE_SDK_ID=
AGE_VERIFICATION_CALLBACK_URL=https://www.gigglemeet.com/home
# TEMPORARY: treats self-attested DOB (18+) as verified, bypassing Yoti.
# No document/liveness check — weaker than the verified-adult claim in
# DEPLOYMENT.md. Unset once YOTI_AGE_API_KEY/YOTI_AGE_SDK_ID are live.
SELF_DECLARED_AGE_ACCESS=false

# Stranger discovery stays off until every release gate in DEPLOYMENT.md passes.
STRANGER_DISCOVERY_ENABLED=false

# Video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Authentication and email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM=Giggle <onboarding@example.com>

# Squad limits
FREE_MAX_MEMBERS=4
PREMIUM_MAX_MEMBERS=8
MAX_SQUAD_MEMBERS=8
MIN_MEMBERS_TO_SEARCH=1

# Logging
ENABLE_REQUEST_LOGS=true
LOG_REQUEST_BODY=false

# Uploaded squad cover storage backend (only "mongo" today; see src/services/coverStorage.js).
COVER_STORAGE=mongo
# Background migration of legacy base64 covers into cover storage after boot (set false to skip).
COVER_BACKFILL_ON_START=true

# Public build-time surface flags. Configure these on Vercel/EAS, not Railway.
NEXT_PUBLIC_STRANGER_DISCOVERY_ENABLED=false
EXPO_PUBLIC_STRANGER_DISCOVERY_ENABLED=false
EXPO_PUBLIC_IOS_DISCOVERY_ENABLED=false
