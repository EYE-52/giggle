# Runtime
NODE_ENV=development
# Local synthetic @dev.giggle.local accounts can enter the app directly.
# Only takes effect when NODE_ENV=development. Keep off in shared environments.
DEV_AUTH_ENABLED=false
PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4000
ADMIN_EMAIL=safety@example.com

# Data stores
MONGODB_URI=mongodb://127.0.0.1:27017/giggle
MONGODB_DB_NAME=giggle
REDIS_URL=redis://127.0.0.1:6379
# Only set this for self-signed Redis TLS certificates in a controlled deployment.
# REDIS_TLS_REJECT_UNAUTHORIZED=false

# Secrets: generate high-entropy production values of at least 32 characters; never commit them.
JWT_SECRET=
AUTH_EXCHANGE_SECRET=

# Verified-adult age assurance. These are server-only values.
YOTI_AGE_API_KEY=
YOTI_AGE_SDK_ID=
AGE_VERIFICATION_CALLBACK_URL=https://www.gigglemeet.com/home
# TEMPORARY: treats self-attested DOB (18+) as verified, bypassing Yoti.
# No document/liveness check — weaker than the verified-adult claim in
# DEPLOYMENT.md. Unset once YOTI_AGE_API_KEY/YOTI_AGE_SDK_ID are live.
SELF_DECLARED_AGE_ACCESS=false

# Stranger discovery stays off until every release gate in DEPLOYMENT.md passes.
STRANGER_DISCOVERY_ENABLED=false

# Selfie → avatar matching (server/src/services/avatarMatchService.js; see
# docs/SELFIE_MATCHING_PLAN.md). Off by default in every environment.
SELFIE_MATCHING_ENABLED=false
# Separate capped OpenRouter key used only for avatar matching; falls back to
# OPENROUTER_API_KEY when empty. Server-only: never expose it to clients.
AVATAR_MATCH_API_KEY=
# Chosen by the measured synthetic pilot. That endpoint lacks json_schema, so
# requests use JSON mode plus our own parseSuggestion validation, with hidden
# reasoning disabled. Set AVATAR_MATCH_STRUCTURED=true and
# AVATAR_MATCH_REASONING_CONTROL=false for a model that needs the opposite.
AVATAR_MATCH_MODEL=qwen/qwen3.7-flash
AVATAR_MATCH_STRUCTURED=false
AVATAR_MATCH_REASONING_CONTROL=true
# One second and final attempt when the primary answers HTTP 429/503; explicitly empty disables it.
AVATAR_MATCH_FALLBACK_MODEL=qwen/qwen3-vl-8b-instruct
# The fallback endpoint lacks json_schema, so the fallback stays on JSON mode.
AVATAR_MATCH_FALLBACK_STRUCTURED=false
# The fallback endpoint lacks the `reasoning` parameter, so the fallback never sends it.
AVATAR_MATCH_FALLBACK_REASONING_CONTROL=false
# Lets tests and local E2E point the provider call at a stub server.
AVATAR_MATCH_BASE_URL=https://openrouter.ai/api/v1
# Spending controls (USD): per-attempt reservation, then app-wide daily and
# monthly ceilings including in-flight reservations. Actual billed cost is
# reconciled after each answer; unknown billing keeps the reservation.
AVATAR_MATCH_RESERVE_USD=0.005
AVATAR_MATCH_DAILY_BUDGET_USD=1
AVATAR_MATCH_MONTHLY_BUDGET_USD=10
AVATAR_MATCH_TIMEOUT_MS=20000

# Video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Authentication and email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM=Giggle <onboarding@example.com>

# Squad limits
FREE_MAX_MEMBERS=4
PREMIUM_MAX_MEMBERS=8
MAX_SQUAD_MEMBERS=8
MIN_MEMBERS_TO_SEARCH=1

# Logging
ENABLE_REQUEST_LOGS=true
LOG_REQUEST_BODY=false

# Uploaded squad cover storage backend (only "mongo" today; see src/services/coverStorage.js).
COVER_STORAGE=mongo
# Background migration of legacy base64 covers into cover storage after boot (set false to skip).
COVER_BACKFILL_ON_START=true

# Public build-time surface flags. Configure these on Vercel/EAS, not Railway.
NEXT_PUBLIC_STRANGER_DISCOVERY_ENABLED=false
EXPO_PUBLIC_STRANGER_DISCOVERY_ENABLED=false
EXPO_PUBLIC_IOS_DISCOVERY_ENABLED=false
