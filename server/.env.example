# Runtime
NODE_ENV=development
PORT=3001
BACKEND_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:4000
ADMIN_EMAIL=safety@example.com

# Data stores
MONGODB_URI=mongodb://127.0.0.1:27017/giggle
MONGODB_DB_NAME=giggle
REDIS_URL=redis://127.0.0.1:6379

# Secrets: generate high-entropy production values of at least 32 characters; never commit them.
JWT_SECRET=
AUTH_EXCHANGE_SECRET=

# Verified-adult age assurance. These are server-only values.
YOTI_AGE_API_KEY=
YOTI_AGE_SDK_ID=
AGE_VERIFICATION_CALLBACK_URL=https://api.example.com/api/me/age-verification/callback

# Stranger discovery stays off until every release gate in DEPLOYMENT.md passes.
STRANGER_DISCOVERY_ENABLED=false

# Video
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Authentication and email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM=Giggle <onboarding@example.com>

# Squad limits
FREE_MAX_MEMBERS=4
PREMIUM_MAX_MEMBERS=8
MAX_SQUAD_MEMBERS=8
MIN_MEMBERS_TO_SEARCH=1

# Logging
ENABLE_REQUEST_LOGS=true
LOG_REQUEST_BODY=false

# Public build-time surface flags. Configure these on Vercel/EAS, not Railway.
NEXT_PUBLIC_STRANGER_DISCOVERY_ENABLED=false
EXPO_PUBLIC_STRANGER_DISCOVERY_ENABLED=false
EXPO_PUBLIC_IOS_DISCOVERY_ENABLED=false
