{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile --filter @giggle/desktop...",
  "buildCommand": "pnpm --filter @giggle/desktop build",
  "outputDirectory": "apps/desktop/.next",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_BACKEND_URL": "https://giggle-server-production.up.railway.app",
    "NEXT_PUBLIC_STRANGER_DISCOVERY_ENABLED": "false"
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
