# Desktop web app (build-time NEXT_PUBLIC_* values; placeholders only).
# Backend API base URL (production builds require this; local dev falls
# back to http://localhost:3001).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Squad games (Game Night embed bridge; optional, default-off when unset).
# The Game Night base URL this app may frame. Same shape rules as the API's
# GAMES_PUBLIC_URL: https in production, http only for local development,
# no credentials/query/hash. Its origin MUST match the API's
# GAMES_PUBLIC_URL origin, or the game panel refuses to frame the answer.
NEXT_PUBLIC_GAMES_URL=http://localhost:8123
