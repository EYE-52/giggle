# PartyBox (Game Night) environment — INERT SAMPLE, no real values.
# Local: copy to .env and run node --env-file=.env server/server.js.
# Hosted: set these in the service's environment variables.
# npm start does not automatically load .env. Never commit real secrets.
# See DEPLOYMENT_PLAN.md for the launch matrix.

# Production: production | Local: leave unset or development
NODE_ENV=

# Bind address (production: 0.0.0.0) and port (host-provided in production)
HOST=0.0.0.0
PORT=8123

# Split-host production: static frontend on Vercel, one Node backend on
# Railway. Frontend https://play.gigglemeet.com serves public/ and rewrites
# /config.json + /qr.svg to the backend; the client dials the backend's
# wss origin directly (never proxied through Vercel).
# Local: leave the two PUBLIC_* URLs unset for same-host sockets (no env
# changes needed for the local preview).

# Public game base URL, exact origin, no trailing slash (QR + share links,
# standalone WS origin gate). Deployment: https://play.gigglemeet.com
PUBLIC_GAME_URL=

# Public websocket endpoint, exact ws(s) origin, no trailing slash. Served
# in public /config.json; deployment: wss://giggle-play-production.up.railway.app
PUBLIC_WEBSOCKET_URL=

# Additional exact standalone WS frontend origins, comma-separated, no
# trailing slash. Split-host DNS window only: the stable own production
# Vercel alias. Deployment: https://giggle-play.vercel.app — never a
# wildcard or ephemeral *.vercel.app preview. Used only by the WS origin
# gate alongside PUBLIC_GAME_URL; never Giggle iframe parent trust.
STANDALONE_ALLOWED_ORIGINS=

# Bridge secret shared ONLY with the Giggle API (exactly equal both sides).
# Must be >= 32 high-entropy chars; empty/disabled = standalone play only.
GAME_BRIDGE_SECRET=

# Exact trusted Giggle parent origins, comma-separated, no trailing slash.
# Deployment: https://www.gigglemeet.com
GIGGLE_ALLOWED_ORIGINS=

# Private player issue inbox. Production must use a persistent volume;
# do not use an ephemeral deployment directory. Local defaults to .data/.
# Railway volume mount /data: GAME_REPORT_DB=/data/reports.sqlite
GAME_REPORT_DB=

# Private operator token (32+ random characters). Never expose to clients.
# Allows inbox reading/status updates via /reports/ or npm run reports.
GAME_REPORT_ADMIN_TOKEN=
# Only for Railway HTTP ingress; local deployments ignore forwarding headers.
# GAME_REPORT_TRUST_RAILWAY=1
