/* {{NAME}} view: thin wrapper on the shared camera-party toolkit view
 * (public/js/toolkit/camera-party.js). Generated by
 * `npm run new-game -- {{ID}} --template camera`.
 *
 * The shared renderer owns all markup, timers, and behavior; this file
 * only loads the engine-owned stylesheet (/css/camera-party.css, same
 * document-link pattern as the shipped camera games) and delegates
 * render/dispose. Owns its clock HUD. A game may ignore the shared
 * renderer and ship bespoke markup against the same snapshots instead —
 * the mount/update/dispose lifecycle is unchanged. */
import { renderCameraParty, disposeCameraParty } from '../toolkit/camera-party.js';

const CSS_ID = 'camera-party-css';
const CSS_HREF = '/css/camera-party.css';

function ensureCss() {
  if (typeof document === 'undefined') return;
  if (document.getElementById(CSS_ID)) return;
  const l = document.createElement('link');
  l.id = CSS_ID;
  l.rel = 'stylesheet';
  l.href = CSS_HREF;
  document.head.appendChild(l);
}

function removeCss() {
  if (typeof document === 'undefined') return;
  const l = document.getElementById(CSS_ID);
  if (l) l.remove();
}

export default {
  ownsTimer: true,
  render(el, S, api) {
    ensureCss();
    return renderCameraParty(el, S, api);
  },
  dispose(el) {
    removeCss();
    return disposeCameraParty(el);
  },
};
