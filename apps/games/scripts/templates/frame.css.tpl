:root{color-scheme:dark;font:18px/1.5 system-ui,sans-serif;background:#171c21;color:#f4f1e8}*{box-sizing:border-box}body{margin:0}main{max-width:780px;margin:auto;padding:72px 20px 32px}h1{font-size:clamp(32px,8vw,64px);line-height:1.1}h2{font-size:28px}a{color:#eaba56}button,input{font:inherit;min-height:48px;padding:10px 16px;border:1px solid #68717c;border-radius:8px}button{background:#eaba56;color:#171c21;cursor:pointer;margin:6px}button:disabled{opacity:.5;cursor:default}input{display:block;width:100%;margin:8px 0;background:#232b32;color:inherit}label{display:block}button:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid #65c9ae;outline-offset:4px}footer{margin-top:24px}[hidden]{display:none!important}
